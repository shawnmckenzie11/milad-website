{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "milad-website",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-27",
	"observability": {
		"enabled": true
	},
	"vars": {
		// On/off switch for the public site. "false" = Coming soon page.
		// Set to "true" and run `npm run deploy` to put the lab site live.
		"SITE_LIVE": "false"
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	// Keep destination_address in sync with site.joinInbox in src/lib/site.ts.
	"send_email": [
		{
			"name": "EMAIL",
			"destination_address": "seashell611@anglernook.com"
		}
	],
	"routes": [
		{
			"pattern": "milad.mckenzian.com",
			"custom_domain": true
		}
		// After miladlab.ca is added as a zone on this Cloudflare account, include:
		// { "pattern": "miladlab.ca", "custom_domain": true },
		// { "pattern": "www.miladlab.ca", "custom_domain": true }
	]
}
