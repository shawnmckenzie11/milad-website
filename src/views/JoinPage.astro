---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinForm from '../components/JoinForm.astro';
import { emphasizeLatinTerms, resolveLocale, useTranslations } from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout title={t.join.metaTitle} description={t.join.metaDescription}>
	<header class="page-header fade-in">
		<p class="eyebrow">{t.join.eyebrow}</p>
		<h1>{t.join.heading}</h1>
	</header>

	<p class="join-intro fade-in-delay" set:html={emphasizeLatinTerms(t.join.intro)} />

	<JoinForm />
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-lg);
	}

	.join-intro {
		margin: 0 0 var(--space-lg);
		color: var(--color-ink-soft);
	}

	.join-intro i {
		font-style: italic;
	}
</style>
