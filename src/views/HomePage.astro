---
import BaseLayout from '../layouts/BaseLayout.astro';
import { emphasizeLatinTerms, resolveLocale, useTranslations } from '../i18n';
import { site } from '../lib/site';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout>
	<section class="home-bio fade-in" aria-labelledby="home-bio-heading">
		<h2 id="home-bio-heading" class="sr-only">{t.home.aboutHeading}</h2>
		<div class="home-bio__layout">
			<img
				class="home-bio__portrait"
				src={site.headshot}
				alt={t.home.headshotAlt}
				width="203"
				height="203"
			/>
			<p set:html={emphasizeLatinTerms(t.home.bio)} />
		</div>
	</section>
</BaseLayout>

<style>
	.home-bio {
		--bio-portrait-size: min(30vh, 13.5rem);
		max-width: min(100% - 2rem, 52rem);
		margin-inline: auto;
		padding: 0 0 var(--space-2xl);
	}

	.home-bio__layout {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 3vw, 2rem);
	}

	.home-bio__portrait {
		flex: 0 0 auto;
		width: min(var(--bio-portrait-size), 203px);
		height: min(var(--bio-portrait-size), 203px);
		object-fit: cover;
		object-position: center top;
		border-radius: 50%;
		border: 1px solid var(--color-line);
		background-color: var(--color-paper-deep);
	}

	.home-bio p {
		flex: 1 1 22rem;
		margin: 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.7;
		text-align: left;
	}

	.home-bio i {
		font-style: italic;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 900px) {
		.home-bio {
			--bio-portrait-size: min(20vh, 9rem);
		}
	}

	@media (max-width: 640px) {
		.home-bio__layout {
			flex-direction: column;
		}

		.home-bio p {
			text-align: center;
		}
	}

	@media (max-width: 560px) {
		.home-bio {
			--bio-portrait-size: min(22vh, 9.5rem);
		}
	}
</style>
