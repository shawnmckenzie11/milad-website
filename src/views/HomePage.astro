---
import BaseLayout from '../layouts/BaseLayout.astro';
import { emphasizeLatinTerms, resolveLocale, useTranslations } from '../i18n';
import { site } from '../lib/site';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<BaseLayout>
	<section class="hero fade-in">
		<div class="hero__skyline">
			<img
				src={site.ottawaBanner}
				alt={t.home.skylineAlt}
				width="1024"
				height="409"
			/>
		</div>
	</section>

	<section class="home-bio" aria-labelledby="home-bio-heading" data-scroll-fade>
		<h2 id="home-bio-heading" class="sr-only">{t.home.aboutHeading}</h2>
		<div class="home-bio__layout">
			<img
				class="home-bio__portrait"
				src={site.headshot}
				alt={t.home.headshotAlt}
				width="203"
				height="203"
			/>
			<p set:html={emphasizeLatinTerms(t.home.bio)} />
		</div>
	</section>

	<noscript>
		<style>
			.home-bio {
				opacity: 1 !important;
				transform: none !important;
			}
		</style>
	</noscript>

	<script is:inline>
		/**
		 * Reveals the homepage biography with a translate-up fade when it
		 * intersects the viewport. Inline so it runs on the static page
		 * without waiting for a bundled island. Reduced-motion visitors
		 * see the paragraph immediately.
		 */
		(function initHomeBioFade() {
			var bio = document.querySelector('[data-scroll-fade]');
			if (!bio || bio.getAttribute('data-fade-ready') === 'true') return;
			bio.setAttribute('data-fade-ready', 'true');

			var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (reduceMotion || typeof IntersectionObserver !== 'function') {
				bio.setAttribute('data-visible', 'true');
				return;
			}

			bio.classList.add('is-pending');

			var observer = new IntersectionObserver(
				function onIntersect(entries) {
					for (var i = 0; i < entries.length; i += 1) {
						if (!entries[i].isIntersecting) continue;
						bio.setAttribute('data-visible', 'true');
						bio.classList.remove('is-pending');
						observer.disconnect();
						return;
					}
				},
				{ root: null, threshold: 0, rootMargin: '0px 0px -12% 0px' },
			);

			observer.observe(bio);
		})();
	</script>
</BaseLayout>

<style>
	.hero,
	.home-bio {
		--hero-logo-height: min(30vh, 13.5rem);
	}

	.hero {
		/* Pull out of .site-main so the skyline can span the viewport. */
		width: 100vw;
		max-width: 100vw;
		margin-inline: calc(50% - 50vw);
		/* Cancel .site-main top padding so the banner sits flush under the nav. */
		margin-top: calc(-1 * var(--space-xl));
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		align-items: center;
		padding: 0;
		background-color: #ffffff;
		overflow: visible;
	}

	.hero__skyline {
		flex: 0 0 auto;
		align-self: stretch;
		width: 100%;
		line-height: 0;
	}

	.hero__skyline img {
		display: block;
		width: 100%;
		height: auto;
		/* Contain the full panorama so Parliament spires are not cropped. */
		object-fit: contain;
		object-position: center top;
	}

	.home-bio {
		max-width: min(100% - 2rem, 52rem);
		margin-inline: auto;
		padding: var(--space-xl) 0 var(--space-2xl);
	}

	.home-bio__layout {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 3vw, 2rem);
	}

	.home-bio__portrait {
		flex: 0 0 auto;
		width: min(var(--hero-logo-height), 203px);
		height: min(var(--hero-logo-height), 203px);
		object-fit: cover;
		object-position: center top;
		border-radius: 50%;
		border: 1px solid var(--color-line);
		background-color: var(--color-paper-deep);
	}

	.home-bio.is-pending {
		opacity: 0;
		transform: translateY(2.75rem);
	}

	.home-bio[data-visible='true'] {
		opacity: 1;
		transform: translateY(0);
		transition:
			opacity 800ms var(--ease-out),
			transform 800ms var(--ease-out);
	}

	.home-bio p {
		flex: 1 1 22rem;
		margin: 0;
		max-width: 42rem;
		font-size: 1.08rem;
		line-height: 1.7;
		text-align: left;
	}

	.home-bio i {
		font-style: italic;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 900px) {
		.hero,
		.home-bio {
			--hero-logo-height: min(20vh, 9rem);
		}
	}

	@media (max-width: 640px) {
		.home-bio__layout {
			flex-direction: column;
		}

		.home-bio p {
			text-align: center;
		}
	}

	@media (max-width: 560px) {
		.hero,
		.home-bio {
			--hero-logo-height: min(22vh, 9.5rem);
		}

		.hero {
			padding-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-bio,
		.home-bio.is-pending,
		.home-bio[data-visible='true'] {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
