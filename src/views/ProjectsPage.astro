---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentProjectCard from '../components/CurrentProjectCard.astro';
import { getCurrentProjects } from '../data/currentProjects';
import { getProjects } from '../lib/research';
import { PREVIOUS_PROJECT_IDS } from '../lib/projectPresentation';
import { site } from '../lib/site';
import {
	getLocalizedCurrentProjects,
	localizePath,
	resolveLocale,
	useTranslations,
} from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const projects = getProjects();
const currentProjects = getLocalizedCurrentProjects(getCurrentProjects(), locale);
const projectsById = new Map(projects.map((project) => [project.id, project]));
const previousProjects = PREVIOUS_PROJECT_IDS.map((id) => projectsById.get(id)).filter(
	(project): project is NonNullable<typeof project> => Boolean(project),
);

const description = t.projects.metaDescription.replace('{name}', t.site.name);
---

<BaseLayout title={t.projects.metaTitle} description={description}>
	<section id="current-projects" class="section section--first fade-in" aria-labelledby="current-projects-heading">
		<div class="section__intro section__intro--current">
			<h2 id="current-projects-heading">{t.projects.currentHeading}</h2>
			<p>{t.projects.currentIntro}</p>
		</div>
		<div class="program-grid program-grid--compact">
			{
				currentProjects.map((project) => (
					<div class="program-grid__item">
						<CurrentProjectCard project={project} />
					</div>
				))
			}
		</div>
	</section>

	<section id="previous-projects" class="section fade-in" aria-labelledby="previous-projects-heading">
		<div class="section__intro">
			<h2 id="previous-projects-heading">{t.projects.previousHeading}</h2>
			<p>{t.projects.previousIntro}</p>
		</div>
		{
			previousProjects.length > 0 ? (
				<div class="previous-list">
					{previousProjects.map((project, index) => (
						<ProjectCard
							project={project}
							figureSide={index % 2 === 0 ? 'left' : 'right'}
						/>
					))}
				</div>
			) : null
		}
	</section>

	<section id="engage" class="section section--engage fade-in-delay" aria-labelledby="engage-heading">
		<div class="section__intro">
			<h2 id="engage-heading">{t.projects.engageHeading}</h2>
			<p>{t.projects.engageIntro}</p>
		</div>

		<div class="engage-grid">
			<div class="engage-panel">
				<h3>{t.projects.studentsHeading}</h3>
				<p>{t.projects.studentsBody}</p>
				<a class="btn btn-primary" href={localizePath(locale, '/join')}>{t.projects.studentsCta}</a>
			</div>
			<div class="engage-panel">
				<h3>{t.projects.collaboratorsHeading}</h3>
				<p>{t.projects.collaboratorsBody}</p>
				<div class="engage-actions">
					<a class="btn btn-secondary" href={`mailto:${site.email}`}>{t.projects.emailLab}</a>
					<a class="btn btn-secondary" href={localizePath(locale, '/publications')}>{t.projects.readPublications}</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.section {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
	}

	.section--first {
		margin-top: 0;
		padding-top: 0;
	}

	.section + .section {
		border-top: 1px solid var(--color-line);
	}

	.section__intro {
		margin-bottom: var(--space-md);
		max-width: 38rem;
	}

	.section__intro p {
		margin: 0;
	}

	.section__intro--current {
		max-width: none;
	}

	.program-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 2.5rem;
	}

	.program-grid__item {
		animation: fade-up 700ms var(--ease-out) both;
		animation-delay: var(--delay, 0ms);
	}

	.previous-list {
		display: grid;
		gap: 0;
	}

	.engage-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
	}

	.engage-panel h3 {
		margin-bottom: 0.4rem;
	}

	.engage-panel p {
		margin: 0 0 var(--space-md);
		max-width: 32rem;
	}

	.engage-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	@media (min-width: 820px) and (max-width: 1023px) {
		html[lang='fr'] .section__intro--current p {
			white-space: normal;
		}
	}

	@media (min-width: 820px) {
		.section__intro--current p {
			white-space: nowrap;
		}

		html[lang='fr'] .section__intro--current p {
			font-size: 0.95rem;
		}

		.program-grid--compact {
			grid-template-columns: 1fr 1fr;
		}

		.engage-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.program-grid__item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
