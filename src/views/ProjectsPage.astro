---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentProjectCard from '../components/CurrentProjectCard.astro';
import ProgramTabs from '../components/ProgramTabs.astro';
import { lungHealthTabProjectIds } from '../data/lungHealthVisual';
import { getCurrentProjects } from '../data/currentProjects';
import { getProjects } from '../lib/research';
import { getProjectPresentation } from '../lib/projectPresentation';
import { site } from '../lib/site';
import {
	getLocalizedCurrentProjects,
	localizePath,
	resolveLocale,
	useTranslations,
} from '../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const projects = getProjects();
const currentProjects = getLocalizedCurrentProjects(getCurrentProjects(), locale);
const previous = [...projects].sort((a, b) => a.order - b.order);
const tabProjectIdSet = new Set<string>(lungHealthTabProjectIds);
const previousAdjacent = previous.filter((project) => !tabProjectIdSet.has(project.id));

/** Previous programs shown in the tabbed list, in established program order. */
const tabProjects = lungHealthTabProjectIds
	.map((id) => previous.find((project) => project.id === id))
	.filter((project): project is NonNullable<typeof project> => Boolean(project));

const methodSet = [
	...new Set(previous.flatMap((project) => getProjectPresentation(project, locale).methods)),
].slice(0, 8);

const description = t.projects.metaDescription.replace('{name}', t.site.name);
---

<BaseLayout title={t.projects.metaTitle} description={description}>
	<section id="current-projects" class="section section--first fade-in" aria-labelledby="current-projects-heading">
		<div class="section__intro">
			<h2 id="current-projects-heading">{t.projects.currentHeading}</h2>
			<p>{t.projects.currentIntro}</p>
		</div>
		<div class="program-grid program-grid--compact">
			{
				currentProjects.map((project) => (
					<div class="program-grid__item">
						<CurrentProjectCard project={project} />
					</div>
				))
			}
		</div>
	</section>

	<section id="previous-projects" class="section fade-in" aria-labelledby="previous-projects-heading">
		<div class="section__intro">
			<h2 id="previous-projects-heading">{t.projects.previousHeading}</h2>
			<p>{t.projects.previousIntro}</p>
		</div>
		{
			tabProjects.length > 0 ? (
				<ProgramTabs projects={tabProjects} listLabel={t.projects.previousTabsLabel} />
			) : null
		}
		{
			previousAdjacent.length > 0 ? (
				<div class="program-grid program-grid--compact previous-adjacent">
					{previousAdjacent.map((project) => (
						<div class="program-grid__item">
							<ProjectCard project={project} variant="secondary" />
						</div>
					))}
				</div>
			) : null
		}
	</section>

	{
		methodSet.length > 0 ? (
			<section id="approaches" class="section section--band fade-in-delay" aria-labelledby="approaches-heading">
				<div class="section__intro">
					<h2 id="approaches-heading">{t.projects.approachesHeading}</h2>
					<p>{t.projects.approachesIntro}</p>
				</div>
				<ul class="approach-list">
					{methodSet.map((method) => (
						<li>{method}</li>
					))}
				</ul>
			</section>
		) : null
	}

	<section id="engage" class="section section--engage fade-in-delay" aria-labelledby="engage-heading">
		<div class="section__intro">
			<h2 id="engage-heading">{t.projects.engageHeading}</h2>
			<p>{t.projects.engageIntro}</p>
		</div>

		<div class="engage-grid">
			<div class="engage-panel">
				<h3>{t.projects.studentsHeading}</h3>
				<p>{t.projects.studentsBody}</p>
				<a class="btn btn-primary" href={localizePath(locale, '/join')}>{t.projects.studentsCta}</a>
			</div>
			<div class="engage-panel">
				<h3>{t.projects.collaboratorsHeading}</h3>
				<p>{t.projects.collaboratorsBody}</p>
				<div class="engage-actions">
					<a class="btn btn-secondary" href={`mailto:${site.email}`}>{t.projects.emailLab}</a>
					<a class="btn btn-secondary" href={localizePath(locale, '/publications')}>{t.projects.readPublications}</a>
				</div>
			</div>
		</div>

		<p class="tooling-note">
			{t.projects.toolingNote}
			<a href={site.scraper.href} target="_blank" rel="noopener noreferrer">{site.scraper.label}</a>
		</p>
	</section>
</BaseLayout>

<style>
	.section {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
	}

	.section--first {
		margin-top: 0;
		padding-top: 0;
	}

	.section + .section {
		border-top: 1px solid var(--color-line);
	}

	.section__intro {
		margin-bottom: var(--space-md);
		max-width: 38rem;
	}

	.section__intro p {
		margin: 0;
	}

	.section--band {
		padding: var(--space-lg) 1.25rem;
		margin-left: -0.25rem;
		margin-right: -0.25rem;
		background: rgba(255, 255, 255, 0.4);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	.program-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 2.5rem;
	}

	.program-grid__item {
		animation: fade-up 700ms var(--ease-out) both;
		animation-delay: var(--delay, 0ms);
	}

	.previous-adjacent {
		margin-top: var(--space-lg);
	}

	.approach-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.55rem 2rem;
	}

	.approach-list li {
		position: relative;
		padding-left: 1rem;
		color: var(--color-ink-soft);
		font-size: 1rem;
	}

	.approach-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.4rem;
		height: 1px;
		background: var(--color-accent);
	}

	.engage-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
	}

	.engage-panel h3 {
		margin-bottom: 0.4rem;
	}

	.engage-panel p {
		margin: 0 0 var(--space-md);
		max-width: 32rem;
	}

	.engage-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tooling-note {
		margin: var(--space-lg) 0 0;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	@media (min-width: 820px) {
		.program-grid--compact {
			grid-template-columns: 1fr 1fr;
		}

		.approach-list {
			grid-template-columns: 1fr 1fr;
		}

		.engage-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}

		.section--band {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.program-grid__item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
