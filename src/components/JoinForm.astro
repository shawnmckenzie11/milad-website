---
import { site } from '../lib/site';
import { resolveLocale, useTranslations } from '../i18n';

interface Props {
	/** Destination mailbox for inquiries. */
	toEmail?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { toEmail = site.email } = Astro.props;

const programs = [
	{ value: 'coop', label: t.joinForm.programs.coop },
	{ value: 'undergrad', label: t.joinForm.programs.undergrad },
	{ value: 'masters', label: t.joinForm.programs.masters },
	{ value: 'phd', label: t.joinForm.programs.phd },
	{ value: 'postdoc', label: t.joinForm.programs.postdoc },
	{ value: 'staff', label: t.joinForm.programs.staff },
	{ value: 'collaboration', label: t.joinForm.programs.collaboration },
] as const;

const eligibilityOptions = [
	{ value: 'permanent-resident', label: t.joinForm.eligibilityOptions['permanent-resident'] },
	{ value: 'canadian-citizen', label: t.joinForm.eligibilityOptions['canadian-citizen'] },
	{ value: 'international', label: t.joinForm.eligibilityOptions.international },
] as const;

const noscriptParts = t.joinForm.noscript.split('{email}');
---

<form
	class="join-form"
	id="join-form"
	data-join-form
	data-to-email={toEmail}
	data-locale={locale}
	novalidate
>
	<p class="join-form__required-note">{t.joinForm.requiredNote}</p>

	<div class="join-field">
		<label for="join-name">{t.joinForm.name} <span aria-hidden="true">*</span></label>
		<input
			id="join-name"
			name="name"
			type="text"
			autocomplete="name"
			required
			aria-required="true"
			aria-describedby="join-name-error"
		/>
		<p class="join-field__error" id="join-name-error" hidden></p>
	</div>

	<div class="join-field">
		<label for="join-email">{t.joinForm.email} <span aria-hidden="true">*</span></label>
		<input
			id="join-email"
			name="email"
			type="email"
			autocomplete="email"
			required
			aria-required="true"
			aria-describedby="join-email-error"
		/>
		<p class="join-field__error" id="join-email-error" hidden></p>
	</div>

	<div class="join-field">
		<label for="join-program">{t.joinForm.program} <span aria-hidden="true">*</span></label>
		<select
			id="join-program"
			name="program"
			required
			aria-required="true"
			aria-describedby="join-program-error"
		>
			<option value="">{t.joinForm.programPlaceholder}</option>
			{programs.map((program) => <option value={program.value}>{program.label}</option>)}
		</select>
		<p class="join-field__error" id="join-program-error" hidden></p>
	</div>

	<div class="join-field">
		<label for="join-eligibility">{t.joinForm.eligibility}</label>
		<select id="join-eligibility" name="eligibility">
			<option value="">{t.joinForm.eligibilityPlaceholder}</option>
			{
				eligibilityOptions.map((option) => (
					<option value={option.value}>{option.label}</option>
				))
			}
		</select>
	</div>

	<div class="join-field">
		<label for="join-comments">{t.joinForm.comments}</label>
		<textarea id="join-comments" name="comments" rows="6" aria-describedby="join-comments-hint"></textarea>
		<p class="join-field__hint" id="join-comments-hint">
			{t.joinForm.commentsHint}
		</p>
	</div>

	<div class="join-field">
		<label for="join-attachments">{t.joinForm.attachments}</label>
		<input
			id="join-attachments"
			name="attachments"
			type="file"
			multiple
			accept=".pdf,.doc,.docx,.txt,.rtf"
			aria-describedby="join-attachments-hint"
		/>
		<p class="join-field__hint" id="join-attachments-hint">
			{t.joinForm.attachmentsHint}
		</p>
	</div>

	<div class="join-form__actions">
		<button class="btn btn-primary" type="submit">{t.joinForm.submit}</button>
	</div>

	<p class="join-form__status" data-join-status role="status" aria-live="polite"></p>

	<noscript>
		<p class="join-form__noscript">
			{noscriptParts[0]}
			<a href={`mailto:${toEmail}`}>{toEmail}</a>
			{noscriptParts[1]}
		</p>
	</noscript>
</form>

<script>
	import { messages } from '../i18n/messages';
	import { resolveLocale } from '../i18n/utils';

	/**
	 * Returns whether a string looks like a usable email address.
	 * @param value - Raw email field value
	 */
	function isValidEmail(value: string): boolean {
		return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
	}

	/**
	 * Reads a program option's visible label from the select element.
	 * @param select - Program-of-interest select
	 */
	function selectedOptionLabel(select: HTMLSelectElement): string {
		return select.selectedOptions[0]?.textContent?.trim() || select.value;
	}

	/**
	 * Sets or clears a field error and aria-invalid state.
	 * @param input - Field control
	 * @param errorId - Id of the associated error element
	 * @param message - Error text, or empty to clear
	 */
	function setFieldError(
		input: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
		errorId: string,
		message: string,
	): void {
		const errorEl = document.getElementById(errorId);
		input.setAttribute('aria-invalid', message ? 'true' : 'false');
		if (errorEl) {
			errorEl.hidden = !message;
			errorEl.textContent = message;
		}
	}

	/**
	 * Builds a mailto URL from validated join-form fields.
	 * @param form - Join inquiry form
	 * @param toEmail - Destination mailbox
	 * @param copy - Localized form strings
	 */
	function buildMailtoUrl(
		form: HTMLFormElement,
		toEmail: string,
		copy: (typeof messages)['en']['joinForm'],
	): string {
		const name = String(new FormData(form).get('name') ?? '').trim();
		const email = String(new FormData(form).get('email') ?? '').trim();
		const program = form.querySelector<HTMLSelectElement>('#join-program');
		const eligibility = form.querySelector<HTMLSelectElement>('#join-eligibility');
		const comments = String(new FormData(form).get('comments') ?? '').trim();
		const files = form.querySelector<HTMLInputElement>('#join-attachments')?.files;

		const programLabel = program ? selectedOptionLabel(program) : '';
		const eligibilityLabel = eligibility?.value
			? selectedOptionLabel(eligibility)
			: copy.notSpecified;

		const fileNames = files && files.length > 0
			? Array.from(files).map((file) => file.name).join(', ')
			: '';

		const lines = [
			`${copy.mailtoName}: ${name}`,
			`${copy.mailtoEmail}: ${email}`,
			`${copy.mailtoProgram}: ${programLabel}`,
			`${copy.mailtoEligibility}: ${eligibilityLabel}`,
			'',
			`${copy.mailtoComments}:`,
			comments || copy.mailtoNone,
		];

		if (fileNames) {
			lines.push(
				'',
				`${copy.mailtoAttachments}: ${fileNames}`,
				copy.mailtoAttachNote,
			);
		}

		const subject = copy.mailtoSubject.replace(
			'{program}',
			programLabel || copy.mailtoSubjectFallback,
		);
		return `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
	}

	/**
	 * Wires accessible validation and mailto submission for the join form.
	 */
	function initJoinForm(): void {
		const form = document.querySelector<HTMLFormElement>('[data-join-form]');
		if (!form || form.dataset.ready === 'true') return;
		form.dataset.ready = 'true';

		const toEmail = form.dataset.toEmail || '';
		const copy = messages[resolveLocale(form.dataset.locale)].joinForm;
		const status = form.querySelector<HTMLElement>('[data-join-status]');
		const nameInput = form.querySelector<HTMLInputElement>('#join-name');
		const emailInput = form.querySelector<HTMLInputElement>('#join-email');
		const programInput = form.querySelector<HTMLSelectElement>('#join-program');

		if (!nameInput || !emailInput || !programInput) return;

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (status) status.textContent = '';

			const name = nameInput.value.trim();
			const email = emailInput.value.trim();
			const program = programInput.value.trim();

			setFieldError(nameInput, 'join-name-error', name ? '' : copy.errorName);
			setFieldError(
				emailInput,
				'join-email-error',
				email && isValidEmail(email) ? '' : copy.errorEmail,
			);
			setFieldError(
				programInput,
				'join-program-error',
				program ? '' : copy.errorProgram,
			);

			const firstInvalid = form.querySelector<HTMLElement>('[aria-invalid="true"]');
			if (firstInvalid) {
				firstInvalid.focus();
				return;
			}

			if (!toEmail) {
				if (status) {
					status.textContent = copy.missingDestination;
				}
				return;
			}

			window.location.href = buildMailtoUrl(form, toEmail, copy);
			if (status) {
				status.textContent = copy.statusOpened;
			}
		});
	}

	initJoinForm();
	document.addEventListener('astro:page-load', initJoinForm);
</script>

<style>
	.join-form {
		display: grid;
		gap: var(--space-md);
		margin-top: var(--space-lg);
		max-width: 36rem;
	}

	.join-form__required-note,
	.join-field__hint,
	.join-form__status,
	.join-form__noscript {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-muted);
	}

	.join-field {
		display: grid;
		gap: 0.35rem;
	}

	.join-field label {
		font-family: var(--font-display);
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.join-field input,
	.join-field select,
	.join-field textarea {
		width: 100%;
		padding: 0.65rem 0.75rem;
		border: 1px solid var(--color-line);
		border-radius: var(--radius);
		background: #fff;
		color: var(--color-ink);
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.4;
	}

	.join-field textarea {
		resize: vertical;
		min-height: 8rem;
	}

	.join-field input:focus,
	.join-field select:focus,
	.join-field textarea:focus {
		outline: 2px solid var(--color-accent);
		outline-offset: 1px;
	}

	.join-field input[aria-invalid='true'],
	.join-field select[aria-invalid='true'],
	.join-field textarea[aria-invalid='true'] {
		border-color: #8a3a3a;
	}

	.join-field__error {
		margin: 0;
		font-size: 0.88rem;
		color: #8a3a3a;
	}

	.join-form__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.join-form button {
		appearance: none;
		cursor: pointer;
		border: 1px solid transparent;
	}
</style>
