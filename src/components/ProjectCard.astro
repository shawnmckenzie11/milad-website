---
import type { Project } from '../lib/research';
import { getProjectDisplayTitle, getProjectPresentation, parseRelatedPublications } from '../lib/projectPresentation';
import {
	localizePath,
	resolveLocale,
	useTranslations,
} from '../i18n';
import ProjectIcon from './ProjectIcon.astro';

interface Props {
	project: Project;
	/** Visual weight: primary programs vs quieter prior/adjacent work. */
	variant?: 'primary' | 'secondary';
	/** Desktop figure placement for figure-led primary blocks. */
	figureSide?: 'left' | 'right';
}

const { project, variant = 'primary', figureSide = 'left' } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const presentation = getProjectPresentation(project, locale);
const displayTitle = getProjectDisplayTitle(project, locale);
const related = parseRelatedPublications(project.body);
const flagship = related[0];
const moreCount = Math.max(related.length - 1, 0);
const isFigureLed = variant === 'primary';
const lightboxId = `figure-lightbox-${project.id}`;
---

<article
	class:list={[
		'program',
		`program--${variant}`,
		`program--${project.status}`,
		'program--has-figure',
		isFigureLed && 'program--figure-led',
		isFigureLed && `program--figure-${figureSide}`,
	]}
	id={project.id}
	tabindex="-1"
	style={`--program-accent: ${presentation.accent};`}
>
	<figure class="program__figure">
		<button
			type="button"
			class="program__figure-trigger"
			data-figure-lightbox-trigger
			data-figure-src={presentation.figure}
			data-figure-alt={presentation.figureAlt}
			aria-controls={lightboxId}
			aria-label={t.projects.viewFigure}
		>
			<img
				class="program__img"
				src={presentation.figure}
				alt={presentation.figureAlt}
				width="960"
				height="720"
				loading="lazy"
				decoding="async"
			/>
		</button>
		<figcaption>{presentation.figureCaption}</figcaption>
	</figure>

	<dialog id={lightboxId} class="figure-lightbox" aria-label={presentation.figureAlt}>
		<button type="button" class="figure-lightbox__close" data-figure-lightbox-close>
			{t.projects.closeLightbox}
		</button>
		<div class="figure-lightbox__stage">
			<img class="figure-lightbox__img" data-figure-lightbox-image alt="" />
		</div>
	</dialog>

	<div class="program__body">
		<header class="program__header">
			<div class="program__title-row">
				<span class="program__icon" aria-hidden="true">
					<ProjectIcon name={presentation.icon} size={22} />
				</span>
				<h2 class="program__title">{displayTitle}</h2>
			</div>
			<p class="program__question">{presentation.question}</p>
		</header>

		{
			presentation.domains.length > 0 ? (
				<p class="program__domains">
					{presentation.domains.map((domain, index) => (
						<>
							{index > 0 ? <span aria-hidden="true"> · </span> : null}
							<span>{domain}</span>
						</>
					))}
				</p>
			) : null
		}

		{
			presentation.methods.length > 0 ? (
				<p class="program__methods">
					<span class="program__methods-label">{t.projects.approachesLabel}</span>
					{presentation.methods.join(' · ')}
				</p>
			) : null
		}

		{presentation.audience ? <p class="program__audience">{presentation.audience}</p> : null}

		<div class="program__evidence">
			{
				flagship ? (
					<>
						<p class="program__evidence-heading">
							<span>{t.projects.evidenceHeading}</span>
							{moreCount > 0 ? (
								<span class="program__evidence-count">
									{t.projects.relatedCount.replace('{count}', String(moreCount))}
								</span>
							) : null}
						</p>
						<ol class="program__papers">
							{related.slice(0, 3).map((paper) => (
								<li>
									{paper.year ? <span class="program__year">{paper.year}</span> : null}
									<span class="program__paper-title">{paper.title}</span>
								</li>
							))}
						</ol>
					</>
				) : null
			}
			<p class="program__pubs-link">
				<a href={localizePath(locale, '/publications')}>{t.projects.browsePublications}</a>
				<a href={localizePath(locale, '/join')}>{t.projects.joinProject}</a>
			</p>
		</div>
	</div>
</article>

<style>
	.program {
		--program-accent: var(--color-accent);
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		padding: 1.15rem 0 1.35rem;
		border-top: 1px solid var(--color-line);
		height: 100%;
	}

	.program--figure-led {
		gap: 1.1rem;
		padding: 1.5rem 0 1.75rem;
		padding-left: 0.9rem;
		border-top: 1px solid var(--color-line);
		border-left: 3px solid var(--program-accent);
		height: auto;
	}

	.program--secondary {
		opacity: 0.92;
		padding-left: 0.75rem;
		border-left: 2px solid color-mix(in srgb, var(--program-accent) 55%, transparent);
	}

	.program__figure {
		position: relative;
		margin: 0;
		min-width: 0;
	}

	.program__figure-trigger {
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
		text-align: inherit;
	}

	.program__figure-trigger:focus-visible {
		outline: 2px solid var(--program-accent);
		outline-offset: 3px;
	}

	.program__img {
		display: block;
		width: 100%;
		height: auto;
		max-height: 22rem;
		object-fit: contain;
		object-position: center;
		background: color-mix(in srgb, var(--program-accent) 6%, var(--color-paper));
	}

	.program--secondary .program__img {
		max-height: 14rem;
	}

	.program__figure figcaption {
		margin-top: 0.45rem;
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--color-muted);
		font-style: italic;
	}

	.program__body {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
	}

	.program__header {
		display: grid;
		gap: 0.45rem;
	}

	.program__title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
	}

	.program__icon {
		display: grid;
		place-items: center;
		margin-top: 0.2rem;
		color: var(--program-accent);
	}

	.program__title {
		margin: 0;
		font-size: clamp(1.2rem, 2vw, 1.45rem);
	}

	.program__question {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.05rem;
		line-height: 1.35;
		color: var(--color-ink);
		max-width: 36rem;
	}

	.program__domains,
	.program__methods,
	.program__audience {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-muted);
		max-width: 36rem;
	}

	.program__methods-label {
		display: inline-block;
		margin-right: 0.45rem;
		font-weight: 600;
		color: var(--color-ink-soft);
	}

	.program__audience {
		color: var(--color-ink-soft);
	}

	.program__evidence {
		margin-top: 0.25rem;
		border-top: 1px solid var(--color-line);
		padding-top: 0.65rem;
	}

	.program__evidence-heading {
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--program-accent);
	}

	.program__evidence-count {
		font-weight: 500;
		color: var(--color-muted);
	}

	.program__papers {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.program__papers li {
		display: grid;
		grid-template-columns: 3.2rem 1fr;
		gap: 0.55rem;
		font-size: 0.92rem;
		color: var(--color-ink-soft);
	}

	.program__year {
		font-variant-numeric: tabular-nums;
		font-weight: 600;
		color: var(--color-muted);
	}

	.program__paper-title {
		line-height: 1.4;
	}

	.program__pubs-link {
		margin: 0.7rem 0 0;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.45rem 1.15rem;
		font-size: 0.9rem;
	}

	@media (min-width: 820px) {
		.program--figure-led {
			display: grid;
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
			align-items: start;
			gap: 1.75rem 2rem;
			padding: 1.75rem 0 2rem 1rem;
		}

		.program--figure-right {
			grid-template-columns: minmax(0, 1.15fr) minmax(0, 1.05fr);
		}

		.program--figure-right .program__figure {
			order: 2;
		}

		.program--figure-right .program__body {
			order: 1;
		}

		.program--figure-led .program__img {
			max-height: 26rem;
		}
	}

	.figure-lightbox {
		position: fixed;
		inset: 0;
		width: min(100vw, 100%);
		height: 100vh;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgba(18, 22, 28, 0.92);
		overflow: hidden;
	}

	.figure-lightbox::backdrop {
		background: rgba(18, 22, 28, 0.92);
	}

	.figure-lightbox__close {
		position: fixed;
		top: 1rem;
		right: 1rem;
		z-index: 2;
		padding: 0.55rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: 999px;
		background: rgba(18, 22, 28, 0.82);
		color: #fff;
		font: inherit;
		font-size: 0.92rem;
		font-weight: 600;
		cursor: pointer;
	}

	.figure-lightbox__close:hover {
		background: rgba(18, 22, 28, 0.95);
	}

	.figure-lightbox__close:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	.figure-lightbox__stage {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: 4.5rem 1.25rem 1.5rem;
		box-sizing: border-box;
	}

	.figure-lightbox__img {
		display: block;
		max-width: min(100%, 72rem);
		max-height: calc(100dvh - 6rem);
		width: auto;
		height: auto;
		object-fit: contain;
	}
</style>

<style is:global>
	body.figure-lightbox-open {
		overflow: hidden;
	}
</style>

<script>
	import '../scripts/figureLightbox.ts';
</script>
