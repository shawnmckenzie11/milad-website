---
import type { ProjectIconId } from '../lib/projectPresentation';

interface Props {
	/** Glyph id matching presentation.icon. */
	name: ProjectIconId;
	/** Accessible label; omit for decorative icons. */
	label?: string;
	/** Icon box size in CSS pixels. */
	size?: number;
}

const { name, label, size = 20 } = Astro.props;
const decorative = !label;
---

<svg
	class="project-icon"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={decorative ? 'true' : undefined}
	role={decorative ? undefined : 'img'}
	aria-label={label}
>
	{
		name === 'lung' ? (
			<>
				<path d="M12 3v5" />
				<path d="M12 8c-3 1.5-6 5-6.5 9-.4 3.2 1.2 5.8 3.8 6.4 1.5.3 3-.3 3.7-1.6" />
				<path d="M12 8c3 1.5 6 5 6.5 9 .4 3.2-1.2 5.8-3.8 6.4-1.5.3-3-.3-3.7-1.6" />
			</>
		) : null
	}
	{
		name === 'droplet' ? (
			<>
				<path d="M12 3c3.5 5 6 8.2 6 11.2A6 6 0 0 1 6 14.2C6 11.2 8.5 8 12 3z" />
				<path d="M10 15.5c.6 1.2 1.6 1.8 2.8 1.8" />
			</>
		) : null
	}
	{
		name === 'alveolus' ? (
			<>
				<circle cx="9" cy="11" r="4.2" />
				<circle cx="15" cy="9.5" r="3.4" />
				<circle cx="14.5" cy="15" r="3.6" />
				<path d="M7.5 13.5c1.2.6 2.4.6 3.5 0" />
			</>
		) : null
	}
	{
		name === 'hex' ? (
			<>
				<path d="M12 3.5 19 7.5v9l-7 4-7-4v-9l7-4z" />
				<path d="M12 8v8M8.5 10.2 12 12l3.5-1.8" />
			</>
		) : null
	}
	{
		name === 'vessel' ? (
			<>
				<path d="M6 18c0-5.5 2-9 6-10.5 3.2-1.2 5.8-.2 7 1.8.8 1.4 1.2 3.2 1 5.2" />
				<path d="M9.2 8.2c-.2-2 .4-3.5 1.4-4.4" />
				<path d="M12.4 7.2c.3-1.8 1.1-3 2.2-3.7" />
				<path d="M15.6 7.8c.8-1.5 2-2.5 3.4-3" />
				<path d="M6 18v2.5M20 14.5V18" />
			</>
		) : null
	}
	{
		name === 'network' ? (
			<>
				<circle cx="6.5" cy="8" r="2.2" />
				<circle cx="17.5" cy="7" r="2.2" />
				<circle cx="12" cy="14" r="2.4" />
				<circle cx="7" cy="18.5" r="1.8" />
				<circle cx="18" cy="17.5" r="1.8" />
				<path d="M8.4 9.2 10.4 12.6M15.6 8.4 13.6 12.4M10.2 15.2 8.4 17.2M13.8 15.2 16.4 16.4M8.7 8.2h6.4" />
			</>
		) : null
	}
</svg>

<style>
	.project-icon {
		display: block;
		flex-shrink: 0;
	}
</style>
