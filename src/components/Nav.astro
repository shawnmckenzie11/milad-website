---
import { site } from '../lib/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

/**
 * Returns whether a nav href matches the current path (exact or section prefix).
 */
function isActive(href: string): boolean {
	if (href === '/') {
		return pathname === '/';
	}
	return pathname === href || pathname.startsWith(`${href}/`);
}

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/publications', label: 'Publications' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/join', label: 'Work With Us' },
] as const;
---

<header class="site-nav">
	<div class="site-nav__inner">
		<a class="site-nav__brand" href="/" aria-label="Milad Lab home">
			<img
				class="site-nav__logo"
				src="/images/milad-lab-banner.jpg"
				alt="Milad Lab, University of Ottawa"
				width="320"
				height="142"
			/>
		</a>
		<nav class="site-nav__links" aria-label="Primary">
			{
				links.map((link) => (
					<a
						href={link.href}
						class:list={['site-nav__link', { 'is-active': isActive(link.href) }]}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
			<a
				class="site-nav__link site-nav__link--external"
				href={site.scraper.href}
				target="_blank"
				rel="noopener noreferrer"
			>
				{site.scraper.navLabel}
				<span class="sr-only"> (opens in a new tab)</span>
			</a>
		</nav>
	</div>
</header>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgba(255, 255, 255, 0.94);
		border-bottom: 1px solid var(--color-line);
	}

	.site-nav__inner {
		width: min(100% - 2.5rem, var(--max-width-wide));
		margin: 0 auto;
		padding: 0.75rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.site-nav__brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		max-width: min(100%, 18rem);
	}

	.site-nav__logo {
		width: 100%;
		height: auto;
		max-height: 3.25rem;
		object-fit: contain;
		object-position: left center;
	}

	.site-nav__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 1.1rem;
	}

	.site-nav__link {
		position: relative;
		color: var(--color-ink-soft);
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.2rem 0;
	}

	.site-nav__link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.15rem;
		width: 100%;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 200ms var(--ease-out);
	}

	.site-nav__link:hover,
	.site-nav__link.is-active {
		color: var(--color-ink);
	}

	.site-nav__link:hover::after,
	.site-nav__link.is-active::after {
		transform: scaleX(1);
	}

	.site-nav__link--external {
		color: var(--color-accent);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 720px) {
		.site-nav__brand {
			max-width: 22rem;
		}

		.site-nav__logo {
			max-height: 3.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__link::after {
			transition: none;
		}
	}
</style>
