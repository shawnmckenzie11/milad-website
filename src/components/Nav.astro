---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localizePath, resolveLocale, stripLocalePrefix, useTranslations } from '../i18n';
import { site } from '../lib/site';

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const pathname = stripLocalePrefix(Astro.url.pathname);

/**
 * Returns whether a nav href matches the current unprefixed path (exact or section prefix).
 * @param href - Unprefixed path such as `/` or `/publications`
 */
function isActive(href: string): boolean {
	if (href === '/') {
		return pathname === '/';
	}
	return pathname === href || pathname.startsWith(`${href}/`);
}

const links = [
	{ href: '/', label: t.nav.home },
	{ href: '/publications', label: t.nav.publications },
	{ href: '/projects', label: t.nav.projects },
	{ href: '/join', label: t.nav.join },
] as const;
---

<header class="site-nav">
	<div class="site-nav__inner">
		<a class="site-nav__brand" href={localizePath(locale, '/')} aria-label={t.nav.brandAria}>
			<img
				class="site-nav__logo"
				src={site.logo}
				alt={t.site.labName}
				width="320"
				height="91"
			/>
		</a>
		<nav class="site-nav__links" aria-label={t.nav.primaryAria}>
			{
				links.map((link) => (
					<a
						href={localizePath(locale, link.href)}
						class:list={['site-nav__link', { 'is-active': isActive(link.href) }]}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
		<div class="site-nav__tools">
			<LanguageSwitcher />
		</div>
	</div>
</header>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-line);
	}

	.site-nav__inner {
		width: min(100% - 2rem, var(--max-width-wide));
		margin: 0 auto;
		padding: 0.6rem 0;
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		gap: 0.65rem 0.85rem;
	}

	.site-nav__brand {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		flex: 0 0 auto;
		max-width: 9.5rem;
	}

	.site-nav__logo {
		width: 100%;
		height: auto;
		max-height: 2.6rem;
		object-fit: contain;
		object-position: left center;
	}

	.site-nav__links {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.35rem 0.75rem;
		flex: 1 1 auto;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
		white-space: nowrap;
	}

	.site-nav__links::-webkit-scrollbar {
		display: none;
	}

	.site-nav__tools {
		flex: 0 0 auto;
	}

	.site-nav__link {
		position: relative;
		flex: 0 0 auto;
		color: var(--color-ink-soft);
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.2rem 0;
	}

	.site-nav__link::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.15rem;
		width: 100%;
		height: 1px;
		background: var(--color-accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 200ms var(--ease-out);
	}

	.site-nav__link:hover,
	.site-nav__link.is-active {
		color: var(--color-ink);
	}

	.site-nav__link:hover::after,
	.site-nav__link.is-active::after {
		transform: scaleX(1);
	}

	@media (min-width: 880px) {
		.site-nav__inner {
			gap: 0.85rem 1.1rem;
		}

		.site-nav__brand {
			max-width: 14rem;
		}

		.site-nav__logo {
			max-height: 3.1rem;
		}

		.site-nav__links {
			gap: 0.45rem 1rem;
		}

		.site-nav__link {
			font-size: 0.74rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav__link::after {
			transition: none;
		}
	}
</style>
