---
/**
 * Full-width academic tabs that switch among active lung-health program cards.
 * Listens for pathway selections from the lung-health visualization.
 */
import type { Project } from '../lib/research';
import { getProjectPresentation } from '../lib/projectPresentation';
import { LUNG_HEALTH_SELECT_PROJECT_EVENT } from '../data/lungHealthVisual';
import { resolveLocale, useTranslations } from '../i18n';
import ProjectCard from './ProjectCard.astro';

interface Props {
	/** Ordered projects shown as tabs (typically the four pathway-linked programs). */
	projects: Project[];
	/** Initially selected project id; defaults to the first project. */
	initialId?: string;
	/** Accessible name for the tab list. */
	listLabel?: string;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { projects, initialId, listLabel = t.projects.programsLabel } = Astro.props;
const selectedId = initialId && projects.some((p) => p.id === initialId)
	? initialId
	: projects[0]?.id;
---

{
	projects.length > 0 ? (
		<div class="program-tabs" data-program-tabs data-select-event={LUNG_HEALTH_SELECT_PROJECT_EVENT}>
			<div
				class="program-tabs__list"
				role="tablist"
				aria-label={listLabel}
			>
				{projects.map((project) => {
					const presentation = getProjectPresentation(project, locale);
					const isSelected = project.id === selectedId;
					return (
						<button
							type="button"
							class:list={['program-tabs__tab', isSelected && 'is-active']}
							role="tab"
							id={`tab-${project.id}`}
							aria-selected={isSelected ? 'true' : 'false'}
							aria-controls={`panel-${project.id}`}
							tabindex={isSelected ? 0 : -1}
							data-tab={project.id}
						>
							<span class="program-tabs__label">{presentation.shortLabel}</span>
						</button>
					);
				})}
			</div>

			<div class="program-tabs__panels">
				{projects.map((project, index) => {
					const isSelected = project.id === selectedId;
					return (
						<div
							class="program-tabs__panel"
							role="tabpanel"
							id={`panel-${project.id}`}
							aria-labelledby={`tab-${project.id}`}
							data-panel={project.id}
							hidden={!isSelected}
						>
							<ProjectCard
								project={project}
								figureSide={index % 2 === 0 ? 'left' : 'right'}
							/>
						</div>
					);
				})}
			</div>
		</div>
	) : null
}

<script>
	/**
	 * Wires tab selection, keyboard roving tabindex, hash deep-links, and
	 * lung-health visualization pathway events.
	 */
	function initProgramTabs() {
		const root = document.querySelector<HTMLElement>('[data-program-tabs]');
		if (!root || root.dataset.tabsReady === 'true') return;
		root.dataset.tabsReady = 'true';

		const eventName =
			root.dataset.selectEvent || 'lung-health:select-project';
		const tabs = Array.from(
			root.querySelectorAll<HTMLButtonElement>('[role="tab"][data-tab]'),
		);
		const panels = Array.from(
			root.querySelectorAll<HTMLElement>('[data-panel]'),
		);

		/**
		 * Activates the tab and panel for a project id.
		 * @param projectId - Target program id
		 * @param options - Focus and scroll behavior
		 */
		function selectTab(
			projectId: string,
			options: { focus?: boolean; scroll?: boolean } = {},
		) {
			const { focus = false, scroll = false } = options;
			let matched = false;

			for (const tab of tabs) {
				const active = tab.dataset.tab === projectId;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', active ? 'true' : 'false');
				tab.tabIndex = active ? 0 : -1;
				if (active) {
					matched = true;
					if (focus) tab.focus();
				}
			}

			for (const panel of panels) {
				const active = panel.dataset.panel === projectId;
				panel.hidden = !active;
			}

			if (matched && scroll) {
				root?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		}

		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				const id = tab.dataset.tab;
				if (id) selectTab(id);
			});

			tab.addEventListener('keydown', (event) => {
				const currentIndex = tabs.indexOf(tab);
				if (currentIndex < 0) return;

				let nextIndex = currentIndex;
				if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
					nextIndex = (currentIndex + 1) % tabs.length;
				} else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
					nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
				} else if (event.key === 'Home') {
					nextIndex = 0;
				} else if (event.key === 'End') {
					nextIndex = tabs.length - 1;
				} else {
					return;
				}

				event.preventDefault();
				const nextId = tabs[nextIndex]?.dataset.tab;
				if (nextId) selectTab(nextId, { focus: true });
			});
		}

		window.addEventListener(eventName, ((event: CustomEvent<{ projectId?: string }>) => {
			const projectId = event.detail?.projectId;
			if (!projectId) return;
			selectTab(projectId);
		}) as EventListener);

		/**
		 * Selects a tab when the URL hash matches a program id.
		 */
		function syncFromHash() {
			const hashId = window.location.hash.replace(/^#/, '');
			if (!hashId) return;
			if (tabs.some((tab) => tab.dataset.tab === hashId)) {
				selectTab(hashId, { scroll: true });
			}
		}

		window.addEventListener('hashchange', syncFromHash);
		syncFromHash();
	}

	initProgramTabs();
	document.addEventListener('astro:page-load', initProgramTabs);
</script>

<style>
	.program-tabs {
		width: 100%;
		scroll-margin-top: 5.5rem;
	}

	.program-tabs__list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		width: 100%;
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-line);
		gap: 0;
	}

	.program-tabs__tab {
		appearance: none;
		-webkit-appearance: none;
		margin: 0;
		border: 0;
		border-bottom: 2px solid transparent;
		background: transparent;
		color: var(--color-muted);
		font-family: var(--font-display);
		font-size: clamp(0.68rem, 1.35vw, 0.78rem);
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-align: center;
		line-height: 1.35;
		padding: 0.85rem 0.55rem 0.95rem;
		cursor: pointer;
		transition:
			color 160ms var(--ease-out),
			border-color 160ms var(--ease-out),
			background-color 160ms var(--ease-out);
	}

	.program-tabs__tab:hover,
	.program-tabs__tab:focus-visible {
		color: var(--color-ink);
		background: var(--color-accent-soft);
		outline: none;
	}

	.program-tabs__tab.is-active {
		color: var(--color-accent);
		border-bottom-color: var(--color-accent);
	}

	.program-tabs__label {
		display: block;
	}

	.program-tabs__panels {
		width: 100%;
	}

	.program-tabs__panel {
		width: 100%;
	}

	.program-tabs__panel[hidden] {
		display: none;
	}

	/* Soften the first card’s top rule under the tab bar. */
	.program-tabs__panel :global(.program) {
		border-top-color: transparent;
		padding-top: 1.35rem;
	}

	@media (max-width: 719px) {
		.program-tabs__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.program-tabs__tab {
			letter-spacing: 0.08em;
			padding: 0.75rem 0.4rem 0.85rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.program-tabs__tab {
			transition: none;
		}
	}
</style>
