---
import type { Publication } from '../lib/research';
import { publicationHref } from '../lib/research';
import { resolveLocale, translatePublicationType, useTranslations } from '../i18n';

interface Props {
	publications: Publication[];
	emptyMessage?: string;
	/** When false, omit the year from each item (e.g. when grouped under a year heading). */
	showYear?: boolean;
	/** When true, render a numbered list (used on the selected-publications landing). */
	numbered?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {
	publications,
	emptyMessage = t.publications.empty,
	showYear = true,
	numbered = false,
} = Astro.props;

const ListTag = numbered ? 'ol' : 'ul';
---

{
	publications.length === 0 ? (
		<p class="pub-empty">{emptyMessage}</p>
	) : (
		<ListTag class:list={['pub-list', numbered && 'pub-list--numbered']}>
			{publications.map((pub) => {
				const href = publicationHref(pub);
				return (
					<li class="pub-item">
						<p class="pub-item__title">
							{href ? (
								<a href={href} target="_blank" rel="noopener noreferrer">
									{pub.title}
								</a>
							) : (
								pub.title
							)}
						</p>
						<p class="pub-item__meta">
							<span>{pub.authors}</span>
							{showYear && (
								<>
									<span aria-hidden="true"> · </span>
									<span>{pub.year}</span>
								</>
							)}
							<span aria-hidden="true"> · </span>
							<span>{pub.venue}</span>
							<span aria-hidden="true"> · </span>
							<span class="pub-item__type">{translatePublicationType(pub.type, locale)}</span>
						</p>
					</li>
				);
			})}
		</ListTag>
	)
}

<style>
	.pub-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-md);
	}

	.pub-list--numbered {
		list-style: decimal;
		padding-left: 1.6rem;
		gap: var(--space-lg);
	}

	.pub-list--numbered .pub-item::marker {
		font-family: var(--font-display);
		font-weight: 800;
		color: var(--color-accent);
	}

	.pub-item__title {
		margin: 0 0 0.25rem;
		font-family: var(--font-display);
		font-size: 1.08rem;
		font-weight: 700;
		color: var(--color-ink);
	}

	.pub-item__title a {
		color: inherit;
		text-decoration: none;
	}

	.pub-item__title a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.pub-item__meta {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	.pub-item__type {
		text-transform: capitalize;
	}

	.pub-empty {
		color: var(--color-muted);
	}
</style>
