---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="site-footer__inner">
		<div>
			<p class="site-footer__name">Milad Lab</p>
			<p class="site-footer__meta">{site.affiliation}</p>
		</div>
		<div class="site-footer__links">
			<a href={`mailto:${site.email}`}>{site.email}</a>
			<a href={site.researchGate.href} target="_blank" rel="noopener noreferrer">
				{site.researchGate.label}
			</a>
			<a href={site.scraper.href} target="_blank" rel="noopener noreferrer">
				{site.scraper.label}
			</a>
		</div>
		<p class="site-footer__copy">© {year} Milad Lab</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-line);
		background: #ffffff;
	}

	.site-footer__inner {
		width: min(100% - 2.5rem, var(--max-width-wide));
		margin: 0 auto;
		padding: var(--space-lg) 0;
		display: grid;
		gap: var(--space-md);
	}

	.site-footer__name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-ink);
	}

	.site-footer__meta,
	.site-footer__copy {
		margin: 0.35rem 0 0;
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		font-size: 0.95rem;
	}

	@media (min-width: 720px) {
		.site-footer__inner {
			grid-template-columns: 1fr auto;
			align-items: end;
		}

		.site-footer__copy {
			grid-column: 1 / -1;
		}
	}
</style>
