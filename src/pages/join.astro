---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinForm from '../components/JoinForm.astro';
import { site } from '../lib/site';

const joinPage = await getEntry('pages', 'join');

if (!joinPage) {
	throw new Error('Missing content/pages/join.md — required for the /join route.');
}

const description = joinPage.data.description ?? `Prospective students and researchers — ${site.name}.`;
---

<BaseLayout title={joinPage.data.title} description={description} narrow>
	<header class="page-header fade-in">
		<p class="eyebrow">Prospective researchers</p>
		<h1>{joinPage.data.title}</h1>
	</header>

	<article class="join-copy fade-in-delay">
		<section aria-labelledby="join-team-heading">
			<h2 id="join-team-heading">Join our team</h2>
			<p>
				Our team is growing! We are currently recruiting motivated candidates at the following
				levels: undergraduate summer interns, coop students, Masters students, and doctoral
				students. Feel free to use the form below to contact our team and we will get back to you
				as soon as possible.
			</p>
		</section>

		<section aria-labelledby="work-with-us-heading">
			<h2 id="work-with-us-heading">Work with us</h2>
			<p>
				Our research group is always looking for collaborators and partnerships. We have the
				expertise and technical ability to study a variety of inhaled exposures (cigarette smoke,
				wood fire smoke, cannabis smoke, e-cigarettes, cannabis vapour) at the <i>in vitro</i> and <i>in vivo</i> levels. If you'd like to explore how these smoke/vapour exposures affect your
				tissue or disease of interest, please get in touch with us through the form below.
			</p>
		</section>
	</article>

	<JoinForm toEmail={site.email} />
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-lg);
	}

	.join-copy {
		display: grid;
		gap: var(--space-lg);
		max-width: 38rem;
	}

	.join-copy h2 {
		margin-bottom: var(--space-sm);
	}

	.join-copy p {
		margin: 0;
	}

	.join-copy i {
		font-style: italic;
	}
</style>
