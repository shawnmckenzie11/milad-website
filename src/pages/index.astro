---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="hero fade-in">
		<img
			class="hero__banner"
			src="/images/milad-lab-banner.jpg"
			alt="Milad Lab, University of Ottawa"
			width="1024"
			height="455"
		/>
	</section>

	<section class="home-bio" aria-labelledby="home-bio-heading" data-scroll-fade>
		<h2 id="home-bio-heading" class="sr-only">About Dr. Nadia Milad</h2>
		<p>
			Dr. Nadia Milad completed her B.Sc., M.Sc. and PhD in pharmacology at McGill University,
			University of British Columbia, and Université Laval, respectively. After her postdoctoral
			training at McMaster University and Nagoya City University, she became an Assistant Professor
			in the School of Pharmaceutical Sciences at the University of Ottawa. Although her previous
			research spans several topics, her recent focus has been on the health impacts of smoke
			exposures. Currently, her translational research program will explore the lung and systemic
			effects of cannabis use, using a combination of <i>in vitro</i> cell culture techniques, <i>in vivo</i> animal models, and clinical data.
		</p>
	</section>
</BaseLayout>

<script>
	/**
	 * Fades in the homepage biography after the visitor scrolls downward
	 * and the paragraph intersects the viewport.
	 */
	function initHomeBioFade(): void {
		const bio = document.querySelector<HTMLElement>('[data-scroll-fade]');
		if (!bio || bio.dataset.fadeReady === 'true') return;
		bio.dataset.fadeReady = 'true';

		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduceMotion) {
			bio.classList.add('is-visible');
			return;
		}

		let lastY = window.scrollY;
		let revealed = false;

		/**
		 * Reveals the biography when a downward scroll brings it into view.
		 */
		function onScroll(): void {
			if (revealed) return;
			const y = window.scrollY;
			const goingDown = y > lastY;
			lastY = y;
			if (!goingDown) return;

			const rect = bio.getBoundingClientRect();
			const viewportHeight = window.innerHeight;
			const inView = rect.top < viewportHeight * 0.88 && rect.bottom > viewportHeight * 0.12;
			if (!inView) return;

			revealed = true;
			bio.classList.add('is-visible');
			window.removeEventListener('scroll', onScroll);
		}

		window.addEventListener('scroll', onScroll, { passive: true });
	}

	initHomeBioFade();
	document.addEventListener('astro:page-load', initHomeBioFade);
</script>

<style>
	.hero {
		min-height: calc(100svh - 6.5rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: var(--space-lg) 0 var(--space-xl);
		max-width: min(100%, 52rem);
	}

	.hero__banner {
		width: 100%;
		height: auto;
		margin: 0;
	}

	.home-bio {
		max-width: 42rem;
		padding: var(--space-xl) 0 var(--space-2xl);
		opacity: 0;
		transform: translateY(14px);
		transition:
			opacity 700ms var(--ease-out),
			transform 700ms var(--ease-out);
	}

	.home-bio.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.home-bio p {
		margin: 0;
		font-size: 1.08rem;
		line-height: 1.7;
	}

	.home-bio i {
		font-style: italic;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 640px) {
		.hero {
			min-height: calc(100svh - 8.5rem);
			padding-top: var(--space-md);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-bio {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
</style>
