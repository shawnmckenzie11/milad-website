---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getPublications } from '../lib/research';
import { site } from '../lib/site';

const publications = getPublications();
const years = [...new Set(publications.map((pub) => pub.year))].sort((a, b) => b - a);
const byYear = years.map((year) => ({
	year,
	publications: publications.filter((pub) => pub.year === year),
}));
---

<BaseLayout
	title="Publications"
	description={`Selected publications by ${site.name}, ${site.affiliation}.`}
	narrow
>
	<header class="page-header fade-in">
		<h1>Publications</h1>
	</header>

	{
		byYear.length > 0 ? (
			<div class="pub-timeline fade-in-delay" data-pub-timeline>
				{byYear.map(({ year, publications: yearPubs }) => (
					<section class="pub-year" aria-labelledby={`year-${year}`} data-year={String(year)}>
						<h2 class="pub-year__heading" id={`year-${year}`}>
							{year}
						</h2>
						<PublicationList publications={yearPubs} showYear={false} />
					</section>
				))}
			</div>
		) : (
			<p class="pub-empty fade-in-delay">No publications listed yet.</p>
		)
	}
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
	}

	.pub-timeline {
		display: grid;
		gap: var(--space-xl);
	}

	.pub-year__heading {
		position: sticky;
		/* Sit just below the sticky site nav (~83px at desktop) */
		top: 5.25rem;
		z-index: 5;
		margin: 0 0 var(--space-md);
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--color-line);
		background: linear-gradient(
			180deg,
			rgba(255, 255, 255, 0.98) 0%,
			rgba(255, 255, 255, 0.94) 70%,
			rgba(255, 255, 255, 0.88) 100%
		);
		backdrop-filter: blur(8px);
		font-family: var(--font-body);
		font-size: 1.05rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.03em;
		color: var(--color-accent);
		line-height: 1.2;
	}

	.pub-empty {
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.pub-year__heading {
			/* Nav wraps taller on small screens */
			top: 7.25rem;
		}
	}
</style>
