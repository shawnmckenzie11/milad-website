---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { getMainAuthorPublications } from '../lib/research';
import { site } from '../lib/site';

const publications = getMainAuthorPublications();
---

<BaseLayout
	title="Publications"
	description={`Selected publications by ${site.name}, ${site.affiliation}.`}
	narrow
>
	<header class="page-header fade-in">
		<h1>Selected Publications</h1>
	</header>

	{
		publications.length > 0 ? (
			<div class="fade-in-delay">
				<PublicationList publications={publications} numbered />
			</div>
		) : (
			<p class="pub-empty fade-in-delay">No publications listed yet.</p>
		)
	}

	<p class="full-list-link fade-in-delay">
		<a href="/publications/all">View the complete publication list</a>
	</p>
</BaseLayout>

<style>
	.page-header {
		margin-bottom: var(--space-xl);
	}

	.pub-empty {
		color: var(--color-muted);
	}

	.full-list-link {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-line);
	}
</style>
