---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentProjectCard from '../components/CurrentProjectCard.astro';
import ProgramTabs from '../components/ProgramTabs.astro';
import LungHealthVisual from '../components/LungHealthVisual';
import { lungHealthTabProjectIds } from '../data/lungHealthVisual';
import { getCurrentProjects } from '../data/currentProjects';
import { getProjects } from '../lib/research';
import { getProjectPresentation } from '../lib/projectPresentation';
import { site } from '../lib/site';

const projects = getProjects();
const currentProjects = getCurrentProjects();
const previous = [...projects].sort((a, b) => a.order - b.order);
const tabProjectIdSet = new Set<string>(lungHealthTabProjectIds);
const previousAdjacent = previous.filter((project) => !tabProjectIdSet.has(project.id));

/** Pathway-linked previous programs in tab order for the visualization section. */
const tabProjects = lungHealthTabProjectIds
	.map((id) => previous.find((project) => project.id === id))
	.filter((project): project is NonNullable<typeof project> => Boolean(project));

const methodSet = [
	...new Set(previous.flatMap((project) => getProjectPresentation(project).methods)),
].slice(0, 8);
---

<BaseLayout
	title="Projects"
	description={`Research programs led by ${site.name} — for prospective trainees and collaborators in biology and health sciences.`}
>
	<section
		id="lung-health-visual"
		class="section section--first section--visual"
		aria-label="Lung health pathways"
	>
		<LungHealthVisual client:load />
	</section>

	<section id="current-projects" class="section fade-in" aria-labelledby="current-projects-heading">
		<div class="section__intro">
			<h2 id="current-projects-heading">Current Projects</h2>
			<p>
				Ongoing programs in the lab examining cannabis exposure, delivery, aging, and immune
				modulation.
			</p>
		</div>
		<div class="program-grid program-grid--compact">
			{
				currentProjects.map((project) => (
					<div class="program-grid__item">
						<CurrentProjectCard project={project} />
					</div>
				))
			}
		</div>
	</section>

	<section id="previous-projects" class="section fade-in" aria-labelledby="previous-projects-heading">
		<div class="section__intro">
			<h2 id="previous-projects-heading">Previous Projects</h2>
			<p>Earlier and collaborative programs that inform current directions.</p>
		</div>
		{
			tabProjects.length > 0 ? (
				<ProgramTabs projects={tabProjects} listLabel="Previous research programs" />
			) : null
		}
		{
			previousAdjacent.length > 0 ? (
				<div class="program-grid program-grid--compact previous-adjacent">
					{previousAdjacent.map((project) => (
						<div class="program-grid__item">
							<ProjectCard project={project} variant="secondary" />
						</div>
					))}
				</div>
			) : null
		}
	</section>

	{
		methodSet.length > 0 ? (
			<section id="approaches" class="section section--band fade-in-delay" aria-labelledby="approaches-heading">
				<div class="section__intro">
					<h2 id="approaches-heading">Approaches in the lab</h2>
					<p>
						Common experimental and analytic threads across programs — useful for matching skills and
						training goals.
					</p>
				</div>
				<ul class="approach-list">
					{methodSet.map((method) => (
						<li>{method}</li>
					))}
				</ul>
			</section>
		) : null
	}

	<section id="engage" class="section section--engage fade-in-delay" aria-labelledby="engage-heading">
		<div class="section__intro">
			<h2 id="engage-heading">Join or collaborate</h2>
			<p>Two clear entry points depending on whether you are seeking training or partnership.</p>
		</div>

		<div class="engage-grid">
			<div class="engage-panel">
				<h3>Prospective students</h3>
				<p>
					If your interests align with a program above — especially inhaled exposures, lung
					immunity, or epithelial methods — start with a short note of interest.
				</p>
				<a class="btn btn-primary" href="/join">Work with us</a>
			</div>
			<div class="engage-panel">
				<h3>Scientists &amp; collaborators</h3>
				<p>
					For shared experiments, methods, or cannabis literature workflows, reach out directly or use
					the community tooling below.
				</p>
				<div class="engage-actions">
					<a class="btn btn-secondary" href={`mailto:${site.email}`}>Email the lab</a>
					<a class="btn btn-secondary" href="/publications">Read publications</a>
				</div>
			</div>
		</div>

		<p class="tooling-note">
			Cannabis researchers:
			<a href={site.scraper.href} target="_blank" rel="noopener noreferrer">{site.scraper.label}</a>
		</p>
	</section>
</BaseLayout>

<style>
	.section {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
	}

	.section--first {
		margin-top: 0;
		padding-top: 0;
	}

	.section--visual {
		margin-bottom: var(--space-lg);
		scroll-margin-top: 5.5rem;
	}

	.section + .section {
		border-top: 1px solid var(--color-line);
	}

	.section__intro {
		margin-bottom: var(--space-md);
		max-width: 38rem;
	}

	.section__intro p {
		margin: 0;
	}

	.section--band {
		padding: var(--space-lg) 1.25rem;
		margin-left: -0.25rem;
		margin-right: -0.25rem;
		background: rgba(255, 255, 255, 0.4);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	.program-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 2.5rem;
	}

	.program-grid__item {
		animation: fade-up 700ms var(--ease-out) both;
		animation-delay: var(--delay, 0ms);
	}

	.previous-adjacent {
		margin-top: var(--space-lg);
	}

	.approach-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.55rem 2rem;
	}

	.approach-list li {
		position: relative;
		padding-left: 1rem;
		color: var(--color-ink-soft);
		font-size: 1rem;
	}

	.approach-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.4rem;
		height: 1px;
		background: var(--color-accent);
	}

	.engage-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
	}

	.engage-panel h3 {
		margin-bottom: 0.4rem;
	}

	.engage-panel p {
		margin: 0 0 var(--space-md);
		max-width: 32rem;
	}

	.engage-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tooling-note {
		margin: var(--space-lg) 0 0;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	@media (min-width: 820px) {
		.program-grid--compact {
			grid-template-columns: 1fr 1fr;
		}

		.approach-list {
			grid-template-columns: 1fr 1fr;
		}

		.engage-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}

		.section--band {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.program-grid__item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
