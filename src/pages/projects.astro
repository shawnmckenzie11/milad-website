---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/research';
import { getProjectPresentation } from '../lib/projectPresentation';
import { site } from '../lib/site';

const projects = getProjects();
const active = projects.filter((project) => project.status === 'active' && project.id !== 'other-recent');
const adjacent = projects.filter((project) => project.id === 'other-recent');
const completed = projects.filter((project) => project.status === 'completed');

const methodSet = [
	...new Set(
		[...active, ...completed].flatMap((project) => getProjectPresentation(project).methods),
	),
].slice(0, 8);
---

<BaseLayout
	title="Current Projects"
	description={`Research programs led by ${site.name} — for prospective trainees and collaborators in biology and health sciences.`}
>
	<section id="active-programs" class="section section--first fade-in" aria-label="Active programs">
		{
			active.length === 0 ? (
				<p>Active programs will appear here as the research portfolio develops.</p>
			) : (
				<div class="program-stack">
					{active.map((project, index) => (
						<div class="program-stack__item" style={`--delay: ${index * 70}ms`}>
							<ProjectCard
								project={project}
								figureSide={index % 2 === 0 ? 'left' : 'right'}
							/>
						</div>
					))}
				</div>
			)
		}
	</section>

	{
		methodSet.length > 0 ? (
			<section id="approaches" class="section section--band fade-in-delay" aria-labelledby="approaches-heading">
				<div class="section__intro">
					<h2 id="approaches-heading">Approaches in the lab</h2>
					<p>
						Common experimental and analytic threads across programs — useful for matching skills and
						training goals.
					</p>
				</div>
				<ul class="approach-list">
					{methodSet.map((method) => (
						<li>{method}</li>
					))}
				</ul>
			</section>
		) : null
	}

	{
		completed.length > 0 || adjacent.length > 0 ? (
			<section class="section fade-in-delay" aria-labelledby="interdisciplinary-heading">
				<div class="section__intro">
					<h2 id="interdisciplinary-heading">Interdisciplinary Work</h2>
					<p>Completed programs and collaborative threads that inform current directions.</p>
				</div>
				<div class="program-grid program-grid--compact">
					{[...completed, ...adjacent].map((project) => (
						<div class="program-grid__item">
							<ProjectCard project={project} variant="secondary" />
						</div>
					))}
				</div>
			</section>
		) : null
	}

	<section id="engage" class="section section--engage fade-in-delay" aria-labelledby="engage-heading">
		<div class="section__intro">
			<h2 id="engage-heading">Join or collaborate</h2>
			<p>Two clear entry points depending on whether you are seeking training or partnership.</p>
		</div>

		<div class="engage-grid">
			<div class="engage-panel">
				<h3>Prospective students</h3>
				<p>
					If your interests align with an active program above — especially inhaled exposures, lung
					immunity, or epithelial methods — start with a short note of interest.
				</p>
				<a class="btn btn-primary" href="/join">How to join the lab</a>
			</div>
			<div class="engage-panel">
				<h3>Scientists &amp; collaborators</h3>
				<p>
					For shared experiments, methods, or cannabis literature workflows, reach out directly or use
					the community tooling below.
				</p>
				<div class="engage-actions">
					<a class="btn btn-secondary" href={`mailto:${site.email}`}>Email the lab</a>
					<a class="btn btn-secondary" href="/publications">Read publications</a>
				</div>
			</div>
		</div>

		<p class="tooling-note">
			Cannabis researchers:
			<a href={site.scraper.href} target="_blank" rel="noopener noreferrer">{site.scraper.label}</a>
		</p>
	</section>
</BaseLayout>

<style>
	.section {
		margin-top: var(--space-xl);
		padding-top: var(--space-lg);
	}

	.section--first {
		margin-top: 0;
		padding-top: 0;
	}

	.section + .section {
		border-top: 1px solid var(--color-line);
	}

	.section__intro {
		margin-bottom: var(--space-md);
		max-width: 38rem;
	}

	.section__intro p {
		margin: 0;
	}

	.section--band {
		padding: var(--space-lg) 1.25rem;
		margin-left: -0.25rem;
		margin-right: -0.25rem;
		background: rgba(255, 255, 255, 0.4);
		border-top: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
	}

	.program-stack {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.program-stack__item {
		animation: fade-up 700ms var(--ease-out) both;
		animation-delay: var(--delay, 0ms);
	}

	.program-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0 2.5rem;
	}

	.program-grid__item {
		animation: fade-up 700ms var(--ease-out) both;
		animation-delay: var(--delay, 0ms);
	}

	.approach-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.55rem 2rem;
	}

	.approach-list li {
		position: relative;
		padding-left: 1rem;
		color: var(--color-ink-soft);
		font-size: 1rem;
	}

	.approach-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.4rem;
		height: 1px;
		background: var(--color-accent);
	}

	.engage-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-lg);
	}

	.engage-panel h3 {
		margin-bottom: 0.4rem;
	}

	.engage-panel p {
		margin: 0 0 var(--space-md);
		max-width: 32rem;
	}

	.engage-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.tooling-note {
		margin: var(--space-lg) 0 0;
		font-size: 0.95rem;
		color: var(--color-muted);
	}

	@media (min-width: 820px) {
		.program-grid--compact {
			grid-template-columns: 1fr 1fr;
		}

		.approach-list {
			grid-template-columns: 1fr 1fr;
		}

		.engage-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}

		.section--band {
			padding-left: 1.5rem;
			padding-right: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.program-stack__item,
		.program-grid__item {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}
</style>
