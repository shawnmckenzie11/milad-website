---
import Nav from '../components/Nav.astro';
import { localeStorageKey, resolveLocale, switchLocalePath, useTranslations } from '../i18n';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	narrow?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
	title,
	description = `${t.site.name} — ${t.site.affiliation}. ${t.site.researchFocus}.`,
	narrow = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${t.site.labName}` : `${t.site.labName} · ${t.site.affiliation}`;
const enPath = switchLocalePath(Astro.url.pathname, 'en');
const frPath = switchLocalePath(Astro.url.pathname, 'fr');
const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="alternate" hreflang="en" href={new URL(enPath, siteOrigin).href} />
		<link rel="alternate" hreflang="fr" href={new URL(frPath, siteOrigin).href} />
		<link rel="alternate" hreflang="x-default" href={new URL(enPath, siteOrigin).href} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{pageTitle}</title>
		<script is:inline define:vars={{ localeStorageKey, locale }}>
			(function persistLocaleChoice() {
				try {
					if (locale === 'fr') {
						localStorage.setItem(localeStorageKey, 'fr');
					}
					var stored = localStorage.getItem(localeStorageKey);
					if (stored !== 'fr') return;
					var path = location.pathname;
					if (path === '/fr' || path.indexOf('/fr/') === 0) return;
					var next = path === '/' ? '/fr/' : '/fr' + path;
					location.replace(next + location.search + location.hash);
				} catch (error) {
					/* Ignore private-mode storage failures. */
				}
			})();
		</script>
	</head>
	<body>
		<div class="site-shell">
			<Nav />
			<main class:list={['site-main', { narrow }]}>
				<slot />
			</main>
		</div>
	</body>
</html>
