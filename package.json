{
  "name": "milad-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:research": "node scripts/sync-research.mjs",
    "lung:validate-layers": "node scripts/generate-lung-cutaway.mjs --validate",
    "lung:generate": "node scripts/generate-lung-cutaway.mjs",
    "lung:extract-legend": "node scripts/run-lung-python.mjs scripts/lung_legend_observability.py --extract-only",
    "lung:classify-legend": "node scripts/run-lung-python.mjs scripts/lung_legend_observability.py --self-test",
    "lung:findings": "node scripts/run-lung-python.mjs scripts/lung_findings_db.py",
    "lung:lab": "npm --prefix tools/lung-legend-lab start",
    "lung:lab:install": "npm --prefix tools/lung-legend-lab install",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.3",
    "framer-motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "sharp": "^0.35.3",
    "svgo": "^4.0.0",
    "wrangler": "^4.114.0"
  }
}
